# Fill with four real keys locally. Never commit the populated server/.env.
GEMINI_UNIT_TEST_API_KEY=
GEMINI_INTEGRATION_TEST_API_KEY=
GEMINI_SYSTEM_TEST_API_KEY=
GEMINI_TRUSTWORTHINESS_API_KEY=

GEMINI_UNIT_TEST_MODEL=gemini-2.5-flash
GEMINI_INTEGRATION_TEST_MODEL=gemini-2.5-flash
GEMINI_SYSTEM_TEST_MODEL=gemini-2.5-flash
AI_EVALUATION_JUDGE_MODEL=gemini-2.5-flash

# Enable after filling all four keys to prohibit using the legacy shared key.
GEMINI_REQUIRE_DEDICATED_KEYS=true
