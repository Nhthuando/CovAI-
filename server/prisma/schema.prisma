generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String?
  githubUserId         String?        @unique
  githubAccessTokenEnc String?
  name                 String?
  avatarUrl            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  passwordResetExpires DateTime?
  passwordResetToken   String?
  aiUsageCount         Int            @default(0)
  aiTokenUsage         Int            @default(0)
  aiUsageDate          String?
  bio                  String?
  jobTitle             String?
  jobs                 Job[]          @relation("UserJobs")
  notifications        Notification[]
  projects             Project[]
}

model Project {
  id              String            @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  repoUrl         String?
  defaultBranch   String?
  rootDir         String?
  jestConfigPath  String?
  storageBasePath String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  hasJest         Boolean           @default(false)
  jestCommand     String?
  aiSuggestions   AiSuggestion[]
  aiTests         AiTest[]
  jobs            Job[]
  notifications   Notification[]
  owner           User              @relation(fields: [ownerId], references: [id])
  snapshots       ProjectSnapshot[]

  @@index([ownerId])
}

model ProjectSnapshot {
  id              String             @id @default(cuid())
  projectId       String
  source          SnapshotSource
  checksum        String?
  commitSha       String?
  storagePath     String
  rootDir         String?
  jestConfigPath  String?
  createdAt       DateTime           @default(now())
  hasJest         Boolean            @default(false)
  jestCommand     String?
  aiContextCache  AiContextCache?
  aiSuggestions   AiSuggestion[]
  aiTests         AiTest[]
  cfgs            Cfg[]
  coverageFiles   CoverageFile[]
  coverageFuncs   CoverageFunction[]
  coverageSummary CoverageSummary?
  cyclomatics     Cyclomatic[]
  codeHygieneIssues CodeHygieneIssue[]
  codeHygieneSummary CodeHygieneSummary?
  jobs            Job[]
  performanceMetric PerformanceMetric?
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, checksum])
  @@unique([projectId, commitSha])
  @@index([projectId])
}

model Job {
  id           String           @id @default(cuid())
  projectId    String
  snapshotId   String?
  userId       String?
  type         JobType
  status       JobStatus        @default(QUEUED)
  progress     Int              @default(0)
  payloadJson  String?
  resultJson   String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  computeTimeMs Int?
  createdAt    DateTime         @default(now())
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot     ProjectSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user         User?            @relation("UserJobs", fields: [userId], references: [id])
  logs         JobLog[]
  output       JobOutput?

  @@index([projectId])
  @@index([snapshotId])
  @@index([status, type])
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  level     String
  message   String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model JobOutput {
  id        String   @id @default(cuid())
  jobId     String   @unique
  stdout    String?
  stderr    String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model CoverageSummary {
  id          String          @id @default(cuid())
  snapshotId  String          @unique
  linesPct    Float
  branchesPct Float
  funcsPct    Float
  stmtsPct    Float
  createdAt   DateTime        @default(now())
  snapshot    ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model CoverageFile {
  id          String          @id @default(cuid())
  snapshotId  String
  filePath    String
  linesPct    Float
  branchesPct Float
  funcsPct    Float
  stmtsPct    Float
  snapshot    ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, filePath])
  @@index([snapshotId])
}

model CoverageFunction {
  id           String          @id @default(cuid())
  snapshotId   String
  filePath     String
  functionName String
  startLine    Int?
  endLine      Int?
  hit          Int
  snapshot     ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, filePath, functionName, startLine])
  @@index([snapshotId, filePath])
}

model Cfg {
  id           String          @id @default(cuid())
  snapshotId   String
  filePath     String
  functionName String
  startLine    Int?
  endLine      Int?
  graphJson    String
  createdAt    DateTime        @default(now())
  snapshot     ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  cyclomatic   Cyclomatic?

  @@unique([snapshotId, filePath, functionName, startLine])
  @@index([snapshotId, filePath])
}

model Cyclomatic {
  id           String          @id @default(cuid())
  snapshotId   String
  cfgId        String?         @unique
  filePath     String
  functionName String
  value        Int
  createdAt    DateTime        @default(now())
  cfg          Cfg?            @relation(fields: [cfgId], references: [id], onDelete: Cascade)
  snapshot     ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, filePath, functionName])
  @@index([snapshotId, filePath])
}

model AiContextCache {
  id          String          @id @default(cuid())
  snapshotId  String          @unique
  inputHash   String
  payloadJson String
  createdAt   DateTime        @default(now())
  snapshot    ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model PerformanceMetric {
  id                    String          @id @default(cuid())
  snapshotId            String          @unique
  performanceScore      Float
  highRiskFunctionCount Int
  averageComplexity     Float
  coverageScore         Float
  executionScore        Float?           @default(0)
  executionTimeMs       Int?             @default(0)
  riskLevel             RiskLevel       @default(MEDIUM)
  createdAt             DateTime        @default(now())
  snapshot              ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model CodeHygieneIssue {
  id          String          @id @default(cuid())
  snapshotId  String
  filePath    String
  line        Int
  column      Int
  type        IssueType
  severity    Severity
  message     String
  rule        String
  createdAt   DateTime        @default(now())
  snapshot    ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

model CodeHygieneSummary {
  id            String          @id @default(cuid())
  snapshotId    String          @unique
  totalIssues   Int
  infoCount     Int
  warningCount  Int
  highCount     Int
  criticalCount Int
  hygieneScore  Float           @default(0)
  createdAt     DateTime        @default(now())
  snapshot      ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

model AiSuggestion {
  id           String               @id @default(cuid())
  projectId    String
  snapshotId   String
  filePath     String
  functionName String
  priority     AiSuggestionPriority
  message      String
  createdAt    DateTime             @default(now())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot     ProjectSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([projectId, snapshotId])
  @@index([snapshotId, filePath])
}

model AiTest {
  id           String          @id @default(cuid())
  projectId    String
  snapshotId   String
  mode         AiTestMode
  filePath     String?
  content      String
  metaJson     String?
  createdAt    DateTime        @default(now())
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot     ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  aiTestResult AiTestResult?

  @@index([projectId, snapshotId])
}

model AiTestResult {
  id        String   @id @default(cuid())
  aiTestId  String   @unique
  status    String
  output    String?
  error     String?
  duration  Int?
  createdAt DateTime @default(now())
  aiTest    AiTest   @relation(fields: [aiTestId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  type      NotificationType
  title     String
  message   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum SnapshotSource {
  ZIP
  GITHUB
}

enum JobType {
  INGEST
  INSTALL_DEPS
  RUN_TESTS
  PARSE_COVERAGE
  BUILD_CFG
  PERFORMANCE_ANALYSIS
  AI_SUGGEST
  AI_TESTS
  CODE_HYGIENE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  JOB_FINISHED
  AI_READY
  SYSTEM
}

enum AiTestMode {
  SKELETON
  FULL
}

enum AiSuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

enum IssueType {
  CONSOLE_LOG
  DEBUGGER
  TODO
  FIXME
  HACK
}

enum Severity {
  INFO
  WARNING
  HIGH
  CRITICAL
}
