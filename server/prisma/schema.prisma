}

model ProjectMember {
  id String @id @default(cuid())
  projectId String
  userId String
  role String
  revision Int @default(0)
  addedByUserId String?
  joinedAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("MemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  @@unique([projectId, userId])
  @@index([userId])
}
model ProjectInvitation {
  id String @id @default(cuid())
  projectId String
  canonicalEmail String
  role String
  tokenHash String @unique
  revision Int @default(0)
  status String @default("PENDING")
  invitedByUserId String?
  acceptedByUserId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  requestId String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveries InvitationDelivery[]
  @@unique([projectId, invitedByUserId, requestId])
  @@unique([projectId, canonicalEmail], map: "ProjectInvitation_pending_email_key", where: raw("(status = 'PENDING'::text)"))
  @@index([projectId, status])
}
model InvitationDelivery {
  id String @id @default(cuid())
  invitationId String
  invitationRevision Int
  encryptedPayload String? @db.Text
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  invitation ProjectInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  @@unique([invitationId, invitationRevision])
  @@index([status, nextAttemptAt])
}
model ProjectEvent {
