model ProjectOperation {
  id String @id @default(cuid())
  projectId String
  snapshotId String?
  actorId String?
  capability String
  type String
  requestId String
  semanticKey String
  capturedWorkspaceRevision Int
  status String @default("ADMITTED")
  primaryJobId String? @unique
  inputJson Json?
  resultJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot ProjectSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  primaryJob Job? @relation(fields: [primaryJobId], references: [id], onDelete: SetNull)
  requests ProjectOperationRequest[]
  @@unique([projectId, actorId, requestId])
  @@unique([projectId, semanticKey], map: "ProjectOperation_active_semantic_key", where: raw("(status = ANY (ARRAY['ADMITTED'::text, 'QUEUED'::text, 'RUNNING'::text, 'PUBLISHING'::text]))"))
