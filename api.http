@baseUrl = http://localhost:5000/api

### Auth
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "dinh@gmail.com",
  "password": "password123",
  "name": "dinh"
}

###
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "huynhtandinh.dev@gmail.com",
  "password": "newPassword123"
}

###
# @name forgotPassword
POST {{baseUrl}}/auth/forgotPassword
Content-Type: application/json

{
  "email": "huynhtandinh.dev@gmail.com"
}

###
# @name resetPassword
# Dán token sau resetPassword/
POST {{baseUrl}}/auth/resetPassword/1484ff0f9c5669498d52120db3c7741d81ea93eface28ec6f53a082f11e2b023
Content-Type: application/json

{
  "newPassword": "newPassword123"
}

