### Projects
# @name createProject
POST {{baseUrl}}/projects
Authorization: Bearer YOUR_TOKEN_HERE
Content-Type: application/json

{
  "name": "My New Project"
}

###
# @name listProjects
GET {{baseUrl}}/projects
Authorization: Bearer YOUR_TOKEN_HERE

###
# @name getProjectById
GET {{baseUrl}}/projects/YOUR_PROJECT_ID
Authorization: Bearer YOUR_TOKEN_HERE

###
# @name deleteProject
DELETE {{baseUrl}}/projects/YOUR_PROJECT_ID
Authorization: Bearer YOUR_TOKEN_HERE

###
# @name uploadZip
POST {{baseUrl}}/projects/YOUR_PROJECT_ID/upload-zip
Authorization: Bearer YOUR_TOKEN_HERE
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name
###
# @name getGithubAuthUrl
# Lưu ý: Thay YOUR_CLIENT_ID bằng ID thực tế của bạn, truy cập vào link bên dưới để lấy code xác thực
# https://github.com/login/oauth/authorize?client_id=Ov23liQyAORXbj6NeqAB&scope=user:email,repo
# @name githubCallback
# Sau khi lấy code thì tự động fallback về api Get bên dưới với tham số code để lấy access token
# GET {{baseUrl}}/auth/github/callback?code=CODE

###
# @name githubOAuthAccess
# Cái này cho việc bật/tắt truy cập vào private repository
