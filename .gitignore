# ==============================================================================
# 1. ROOT WHITELIST (Strict Lockdown - Cấm toàn bộ ngoại trừ danh sách dưới)
# ==============================================================================
# Bỏ qua toàn bộ file và folder ở thư mục root
/*

# Whitelist các FILE duy nhất được phép ở root
!.gitignore
!AGENTS.md
!api.http
!docker-compose.yml
!docker-compose.production.yml
!package.json
!package-lock.json
!README.md

# Whitelist các THƯ MỤC duy nhất được phép ở root
!.agents/
!client/
!docs/
!server/
!shared/

# ==============================================================================
# 2. QUY TẮC BỎ QUA NỘI BỘ (Bên trong client, server, shared, docs...)
# ==============================================================================
# Dependencies
node_modules/
.npm-cache/

# Environment & Secrets
.env
.env.*
!.env.example

# Build Outputs
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Metadata
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# CovAI Runtime Temp & Test Artifacts
.covai-temp/
.covai-data/
test-results/
/client/.evidence-review/
/client/evidence-preview.html

# Office, Binary & Document Exports
*.docx
*.xlsx
*.bak
*.pdf

# Research & Superpowers Spec Restrictions
.understand-anything/
/.specify/
/specs/
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-10-09-project-analysis-export-design.md
!/docs/superpowers/specs/2026-10-28-project-collaboration-design.md
!/docs/superpowers/specs/2026-11-04-collaborative-editor-design.md
/docs/research/
!/docs/research/*.md
