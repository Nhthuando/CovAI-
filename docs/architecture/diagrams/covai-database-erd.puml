@startuml CovAI_Database_ERD
title <b>CovAI System - Entity Relationship Diagram (ERD)</b>\n<size:13>PostgreSQL Relational Database Schema (Deployed on Neon Database)</size>

skinparam dpi 200
skinparam linetype ortho
skinparam roundCorner 4
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  BorderThickness 1.3
  FontColor #1C2833
}

' ==============================================================================
' 1. USER & PROJECT MANAGEMENT
' ==============================================================================
entity "User" as User {
  * id : String <<PK>>
  --
  * email : String
  name : String
  passwordHash : String
  githubUserId : String
  aiUsageCount : Int
  aiTokenUsage : Int
  createdAt : DateTime
}

entity "Project" as Project {
  * id : String <<PK>>
  --
  * ownerId : String <<FK>>
  * name : String
  repoUrl : String
  defaultBranch : String
  hasJest : Boolean
  hasVitest : Boolean
  createdAt : DateTime
}

entity "ProjectSnapshot" as Snapshot {
  * id : String <<PK>>
  --
  * projectId : String <<FK>>
  * storagePath : String
  source : SnapshotSource
  checksum : String
  commitSha : String
  selectedTestingFramework : String
  createdAt : DateTime
}

' ==============================================================================
' 2. CODE ANALYSIS & METRICS
' ==============================================================================
entity "QualityReport" as Quality {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  * projectId : String <<FK>>
  overallScore : Float
  performanceScore : Float
  securityScore : Float
  coverageScore : Float
  maintainabilityScore : Float
  recommendations : String
  createdAt : DateTime
}

entity "Cfg" as Cfg {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  filePath : String
  functionName : String
  graphJson : String
}

entity "Cyclomatic" as CC {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  cfgId : String <<FK>>
  filePath : String
  functionName : String
  value : Int
}

entity "Vulnerability" as Vuln {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  type : String
  severity : String
  file : String
  line : Int
  description : String
}

' ==============================================================================
' 3. TEST COVERAGE & RUNS
' ==============================================================================
entity "CoverageSummary" as CovSummary {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  linesPct : Float
  branchesPct : Float
  funcsPct : Float
  stmtsPct : Float
}

entity "CoverageFile" as CovFile {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  filePath : String
  linesPct : Float
  branchesPct : Float
}

entity "CoverageFunction" as CovFunc {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  filePath : String
  functionName : String
  hit : Int
}

entity "TestRun" as TestRun {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  type : TestType
  totalTests : Int
  passedTests : Int
  failedTests : Int
  durationMs : Float
  status : String
}

' ==============================================================================
' 4. AI TEST GENERATION
' ==============================================================================
entity "AiTest" as AiTest {
  * id : String <<PK>>
  --
  * projectId : String <<FK>>
  * snapshotId : String <<FK>>
  mode : AiTestMode
  filePath : String
  content : String
  createdAt : DateTime
}

entity "AiTestResult" as AiResult {
  * id : String <<PK>>
  --
  * aiTestId : String <<FK>>
  status : String
  output : String
  duration : Int
}

' ==============================================================================
' 5. EXTENDED: LLM / RAG EVALUATION (MỚI BỔ SUNG)
' ==============================================================================
entity "RagDataset" as RagDataset #EBF5FB {
  * id : String <<PK>>
  --
  * projectId : String <<FK>>
  name : String
  datasetType : String
  itemCount : Int
  createdAt : DateTime
}

entity "RagEvaluation" as RagEval #EBF5FB {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  * projectId : String <<FK>>
  datasetId : String <<FK>>
  name : String
  status : String
  faithfulnessScore : Float
  answerRelevanceScore : Float
  contextPrecisionScore : Float
  hallucinationRate : Float
  promptInjectionResilience : Float
  toxicityScore : Float
  avgLatencyMs : Float
  totalTokensUsed : Int
  estimatedCostUsd : Float
  createdAt : DateTime
}

entity "RagTestCase" as RagItem #EBF5FB {
  * id : String <<PK>>
  --
  * evaluationId : String <<FK>>
  query : String
  retrievedContext : String
  actualAnswer : String
  groundTruth : String
  faithfulness : Float
  relevance : Float
  passed : Boolean
  latencyMs : Int
}

' ==============================================================================
' 6. EXTENDED: LOAD TESTING (MỚI BỔ SUNG)
' ==============================================================================
entity "LoadTestRun" as LoadTest #F4ECF7 {
  * id : String <<PK>>
  --
  * snapshotId : String <<FK>>
  targetEndpoint : String
  virtualUsers : Int
  durationSeconds : Int
  requestsPerSec : Float
  p95LatencyMs : Float
  errorRate : Float
  createdAt : DateTime
}

' ==============================================================================
' RELATIONSHIPS (Crow's Foot Notation)
' ==============================================================================
User ||--o{ Project : "owns"
Project ||--o{ Snapshot : "has snapshots"
Project ||--o{ Quality : "has reports"
Project ||--o{ RagDataset : "manages datasets"
Project ||--o{ RagEval : "runs evaluations"

Snapshot ||--o{ CovFile : "analyzes"
Snapshot ||--o{ CovFunc : "analyzes"
Snapshot ||--|| CovSummary : "summarizes"
Snapshot ||--o{ Cfg : "builds CFG"
Snapshot ||--o{ CC : "calculates CC"
Snapshot ||--o{ Vuln : "detects"
Snapshot ||--o{ TestRun : "executes"
Snapshot ||--|| Quality : "evaluates"
Snapshot ||--o{ AiTest : "generates tests"
Snapshot ||--o{ RagEval : "benchmarks RAG"
Snapshot ||--o{ LoadTest : "profiles performance"

Cfg ||--o| CC : "links to"
AiTest ||--o| AiResult : "produces"
RagDataset ||--o{ RagEval : "benchmarked against"
RagEval ||--o{ RagItem : "contains test cases"

@enduml
