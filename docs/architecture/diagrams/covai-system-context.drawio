        <mxCell id="rel_covai_github" edge="1" parent="1" source="system_covai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.35;entryX=0.35;entryY=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="ext_github" value="Authenticates via OAuth, fetches repo&lt;br&gt;metadata, clones source code&lt;br&gt;&lt;i style=&quot;color:#666;&quot;&gt;[HTTPS / REST API / Git]&lt;/i&gt;">
