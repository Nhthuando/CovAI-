<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="CovAI_System_Context" name="CovAI System Context Diagram">
    <mxGraphModel dx="1471" dy="803" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b style=&quot;font-size:22px; font-family: Segoe UI, Arial, sans-serif;&quot;&gt;System Context Diagram for CovAI System&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1000" x="325" y="25" as="geometry" />
        </mxCell>
        <mxCell id="header_caption" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;span style=&quot;font-size:13px; color:#555555; font-family: Segoe UI, Arial, sans-serif;&quot;&gt;[C4 Model - Level 1: System Context] Test Coverage Analysis and AI-Driven Test Generation Platform&lt;/span&gt;" vertex="1">
          <mxGeometry height="25" width="1000" x="325" y="58" as="geometry" />
        </mxCell>
        <mxCell id="actor_developer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:15px;&quot;&gt;Developer / QA Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#e0e0e0;&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.3;&quot;&gt;Software developer, QA tester, or team lead who develops, tests, and analyzes JavaScript &amp;amp; TypeScript applications.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="270" x="690" y="110" as="geometry" />
        </mxCell>
        <mxCell id="system_covai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4D8C;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=2;" value="&lt;div style=&quot;padding-top:6px;&quot;&gt;&lt;b style=&quot;font-size:16px;&quot;&gt;CovAI System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#e0e0e0;&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.35;&quot;&gt;AI-driven test coverage analysis &amp;amp; automated test generation platform. Ingests source code, auto-detects frameworks, executes tests in isolated Docker containers, computes 4-dimension coverage (stmt/branch/func/line), builds AST-based CFG &amp;amp; Cyclomatic Complexity, and generates AI tests &amp;amp; suggestions.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="635" y="380" as="geometry" />
        </mxCell>
        <mxCell id="ext_github" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#f0f0f0;&quot;&gt;[External Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.3;&quot;&gt;VCS platform providing OAuth 2.0 authentication, repository metadata, source code cloning, and push/pull-request webhook triggers.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="220" x="50" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ext_docker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;Docker Execution Environment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#f0f0f0;&quot;&gt;[External Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; line-height:1.3;&quot;&gt;Sandboxed container runtime that installs dependencies and runs test runners (Jest, Vitest, Supertest, Playwright, Cypress) in isolation, returning execution logs and coverage artifacts.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="310" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ext_gemini" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;Google Gemini AI Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#f0f0f0;&quot;&gt;[External Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.3;&quot;&gt;External Cloud LLM service providing code analysis, coverage improvement recommendations, test skeletons, and full runnable test suites.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="590" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ext_firebase" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;Firebase Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#f0f0f0;&quot;&gt;[External Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.3;&quot;&gt;Cloud object storage for persistent storage of source snapshots, project ZIP archives, and raw coverage artifacts (LCOV, JSON).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="860" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ext_email" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=top;arcSize=6;shadow=0;strokeWidth=1.5;" value="&lt;div style=&quot;padding-top:4px;&quot;&gt;&lt;b style=&quot;font-size:14px;&quot;&gt;Email Service (SMTP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#f0f0f0;&quot;&gt;[External Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; line-height:1.3;&quot;&gt;Transactional email delivery service for password resets, verification tokens, and critical analysis alerts.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="1130" y="740" as="geometry" />
        </mxCell>
        <mxCell id="rel_dev_covai" edge="1" parent="1" source="actor_developer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="system_covai" value="Manages projects, uploads ZIP, imports repos,&lt;br&gt;triggers test analysis, views CFG/CC, requests AI tests&lt;br&gt;&lt;i style=&quot;color:#666;&quot;&gt;[HTTPS / Web Browser]&lt;/i&gt;">
